#!/bin/sh
# Auto-bump the patch version in package.json on every commit.
# Skipped when the staged version already differs from HEAD (a manual
# major/minor bump) and on `git commit --amend` (HEAD already bumped).
# Installed by `npm install` / `npm test` via core.hooksPath.
set -e

case "$(ps -o args= -p "$PPID")" in
  *--amend*) exit 0 ;;
esac

version_of() {
  git show "$1:package.json" 2>/dev/null |
    node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(s?JSON.parse(s).version:""))'
}

head_version=$(version_of HEAD)
staged_version=$(version_of '')

if [ "$head_version" != "$staged_version" ]; then
  exit 0
fi

if ! git diff --quiet -- package.json; then
  echo 'pre-commit: package.json has unstaged changes; stage or stash them before committing.' >&2
  exit 1
fi

npm version patch --no-git-tag-version --silent >/dev/null
git add package.json
echo "pre-commit: version $head_version -> $(version_of '')"
